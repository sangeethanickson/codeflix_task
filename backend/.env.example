# ---- Backend environment configuration ----
# Copy this file to ".env" and fill in the values.

# Node environment: development | production
NODE_ENV=development

# Port the Express API listens on
PORT=5001

# MongoDB connection string (local default shown)
MONGO_URI=mongodb://localhost:27017/tr3_hr_db

# Secret used to sign/verify JWTs.
# REQUIRED in production. Generate a strong valcue, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=97594796c90ec22f4a8935372c55921090f06b63457882ba9e1acb91e8969b491ed79208fa209ff9303eb9f2c39f8341

# Token lifetime (zeit/ms format): e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000
